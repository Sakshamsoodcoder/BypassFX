# ============================================================
# BypassFX — Root .gitignore
# ============================================================

# Dependencies
node_modules/
backend/node_modules/
package-lock.json.bak
yarn-error.log
npm-debug.log*
yarn-debug.log*

# Environment Configurations & Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env

# Explicitly track configuration templates & examples
!.env.example
!backend/.env.example

# Operating System Files & Artifacts
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Editor & IDE Directories
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-workspace
*.sublime-project

# Logs, Diagnostic Dumps & Runtime Data
*.log
logs/
pids/
*.pid
*.seed
*.pid.lock

# Test Coverage & Caching
coverage/
.nyc_output/
.cache/
.parcel-cache/
.eslintcache

# Build Outputs (when generated)
dist/
build/
out/

# Python Fallback Exclusions (in case local virtual environments or tools are introduced)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
downloads/
eggs/
.eggs/
parts/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Essential Data Files Safeguard (Do NOT ignore json-server mock/seed database)
!db.json
